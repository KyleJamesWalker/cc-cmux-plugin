{
  "name": "cmux-integration",
  "description": "cmux terminal integration for Claude Code — status bar, notifications, pane management, and agent orchestration inside cmux workspaces",
  "version": "1.1.0",
  "license": "MIT",
  "permissions": {
    "allow": [
      "Bash(cmux *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CMUX_WORKSPACE_ID\" ] || cmux notify --title \"Claude Code\" --body \"$(jq -r '.message // empty')\"",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CMUX_WORKSPACE_ID\" ] || cat \"${CLAUDE_PLUGIN_ROOT}/rules/cmux-integration.md\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CMUX_WORKSPACE_ID\" ] || cmux clear-progress",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
